{
  "name": "aftersales-dashboard",
  "version": "0.6.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build && node scripts/prepare-standalone.mjs",
    "check": "tsc --noEmit && eslint .",
    "dev": "next dev --hostname 127.0.0.1 --port 18091",
    "start": "node .next/standalone/server.js",
    "test": "vitest run",
    "test:data": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -p 'test_*.py'",
    "verify": "pnpm check && pnpm test && pnpm test:data && pnpm build"
  },
  "dependencies": {
    "@swc/helpers": "0.5.23",
    "@tanstack/react-virtual": "^3.14.10",
    "date-fns": "4.1.0",
    "exceljs": "4.4.0",
    "lucide-react": "^0.454.0",
    "mysql2": "3.23.1",
    "next": "16.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
